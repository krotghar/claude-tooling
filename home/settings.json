{
  "permissions": {
    "allow": [
      "Edit(~/Documents/claude-config/**)",
      "Edit(<path to claude-tooling>/**)"
    ],
    "additionalDirectories": [
      "~/Documents/claude-config",
      "<path to claude-tooling>"
    ]
  },
  "model": "opus[1m]",
  "effortLevel": "medium",
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline.sh"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/name-session-hook.sh"
          }
        ]
      }
    ]
  }
}
