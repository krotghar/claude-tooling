# Общие паттерны утечек для hooks/pre-commit: расширенные регэкспы (grep -E),
# без учёта регистра, строка — паттерн, `#` — комментарий. Личные паттерны
# (имена, проекты, хосты, hostname) — в $CLAUDE_DATA/.leak-patterns, не здесь.

# Домашние каталоги — выдают имя пользователя.
(^|[[:space:]"'`(=:])/Users/[A-Za-z0-9._-]+
(^|[[:space:]"'`(=:])/home/[A-Za-z0-9._-]+

# Ключи и токены.
-----BEGIN [A-Z ]*PRIVATE KEY
gh[pousr]_[A-Za-z0-9]{20,}
github_pat_[A-Za-z0-9_]{20,}
sk-[A-Za-z0-9_-]{20,}
AKIA[0-9A-Z]{16}
xox[abpr]-[A-Za-z0-9-]{10,}

# Внутренние хосты и адреса (RFC1918).
[A-Za-z0-9-][.]lan([^A-Za-z0-9-]|$)
[A-Za-z0-9-][.](corp|internal|intranet)([^A-Za-z0-9-]|$)
(^|[^0-9.])10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}
(^|[^0-9.])192[.]168[.][0-9]{1,3}[.][0-9]{1,3}
(^|[^0-9.])172[.](1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}[.][0-9]{1,3}
